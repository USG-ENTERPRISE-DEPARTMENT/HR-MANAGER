# Every account in a GL journal is screened against the core system's validateNormalAccounts
# endpoint before posting; any unrecognised account blocks the posting and the bulk-payment API is
# never called. Set to 'off' ONLY to disable the check entirely (e.g. an environment where the
# validator is unreachable) — anything else, including leaving this unset, enforces it.
# GL_VALIDATE_ACCOUNTS=off
# Defaults to the validateNormalAccounts path on the POSTING_API_URL host; set to override.
# GL_VALIDATE_URL=http://10.203.14.33:8181/core/api/v1.1/account/validateNormalAccounts

