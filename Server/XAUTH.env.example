# Staff360 XAuth (server-side only; never expose XAUTH_APP_SECRET to the client)
XAUTH_BASE_URL=http://10.32.11.53:8282
XAUTH_APP_KEY=replace-with-registered-app-key
XAUTH_APP_SECRET=replace-with-registered-app-secret
# Optional HTTP timeout for XAuth token decoding and role sync calls.
XAUTH_TIMEOUT_MS=10000
# Role sync to Staff 360 runs whenever the key/secret above are set. Set to false to switch it off
# (e.g. a dev box sharing the deployed app key).
XAUTH_ROLE_SYNC=true
